@model MVC_Assign2.Models.Student

<h2 style="text-align:center;">Add Student</h2>

<form method="post" style="width:300px; margin:auto;">

    <div style="margin-bottom:10px;">
        <label>Name</label><br />
        <input type="text" name="Name" style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <label>Age</label><br />
        <input type="number" name="Age" style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <label>Email</label><br />
        <input type="text" name="Email" style="width:100%; padding:5px;" />
    </div>

    <button type="submit" style="width:100%; padding:8px; background-color:green; color:white; border:none;">
        Save
    </button>

</form>