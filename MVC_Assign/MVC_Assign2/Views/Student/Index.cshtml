@model List<MVC_Assign2.Models.Student>

<h2 style="text-align:center;">Student List</h2>

<div style="text-align:center; margin-bottom:15px;">
    <a href="/Student/Create" style="padding:8px 15px; background-color:green; color:white; text-decoration:none; border-radius:5px;">
        Add Student
    </a>
</div>

<table style="margin:auto; border-collapse:collapse; width:60%; text-align:center;">
    <tr style="background-color:#007bff; color:white;">
        <th style="padding:10px;">Name</th>
        <th style="padding:10px;">Age</th>
        <th style="padding:10px;">Email</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr style="background-color:#f2f2f2;">
            <td style="padding:10px;">@item.Name</td>
            <td style="padding:10px;">@item.Age</td>
            <td style="padding:10px;">@item.Email</td>
        </tr>
    }
</table>